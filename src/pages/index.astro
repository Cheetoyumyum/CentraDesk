---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import UseCases from '../components/UseCases.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const pageTitle = "CentraDesk | The IT Help Desk for Microsoft 365";
const pageDescription = "Stop paying per-user fees. CentraDesk is a modern, one-time purchase IT solution that lives in your secure SharePoint environment. Manage tickets, assets, and more.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Header />
	<main>
		<Hero />
		<Features />
		<UseCases />
		<CTA />
	</main>
	<Footer />
</Layout>