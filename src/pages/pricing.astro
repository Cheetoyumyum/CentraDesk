---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="Pricing | CentraDesk">
	<Header />
	<main>
		<section class="pricing-hero">
			<div class="container">
				<h1>One Price. Unlimited Users. Forever.</h1>
				<p class="subtitle">Stop paying per-user, per-month fees. CentraDesk is a one-time investment that lives in your own secure Microsoft 365 environment, leveraging the licenses you already own.</p>
			</div>
		</section>

		<section class="pricing-table">
			<div class="container">
				<div class="grid">
					<!-- PROFESSIONAL PACKAGE -->
					<div class="card recommended">
						<div class="card-header">
							<h3>Professional Package</h3>
							<span class="badge">Recommended</span>
						</div>
						<div class="price">$4,995 <span class="duration">/ one-time</span></div>
						<p class="card-description">The complete, professionally installed solution for your business.</p>
						<ul class="features-list">
							<li>Perpetual License for CentraDesk</li>
							<li><strong>Unlimited</strong> End-Users & IT Agents</li>
							<li><strong>Full Turnkey Implementation</strong></li>
							<li>Logo & Brand Color Theming</li>
							<li>All Automated Workflows Setup</li>
							<li>2-Hour Team Training Session</li>
							<li><strong>1 Year of Support & Updates Included</strong></li>
						</ul>
						<a href="mailto:info@centradesk.ca" class="cta-link">
                            <div class="cta-button">Get Started</div>
                        </a>
					</div>

					<!-- BUSINESS PACKAGE -->
					<div class="card">
						<div class="card-header">
							<h3>Business Package</h3>
						</div>
						<div class="price">$7,495 <span class="duration">/ one-time</span></div>
						<p class="card-description">Everything in Professional, plus advanced analytics.</p>
						<ul class="features-list">
							<li>Includes All Professional Features</li>
							<li><strong>Power BI Analytics Starter Kit</strong></li>
							<li>2-Hour Dedicated Analytics Session</li>
							<li>Priority Support (First Year)</li>
                            <li>&nbsp;</li>
							<li>&nbsp;</li>
							<li>&nbsp;</li>
						</ul>
						<a href="mailto:info@centradesk.ca" class="cta-link">
                            <div class="cta-button">Get Started</div>
                        </a>
					</div>
				</div>
                <div class="support-plan">
                    <h3>Annual Support & Maintenance Plan</h3>
                    <p>Continue to receive product updates, new features, and priority support after your first year.</p>
                    <div class="price">$995 <span class="duration">/ year</span></div>
                </div>
			</div>
		</section>

		<section class="value-comparison">
			<div class="container">
				<h2>A Smarter Investment.</h2>
				<p class="subtitle">See how a one-time fee for CentraDesk compares to just three years of a typical SaaS subscription.</p>
				<div class="comparison-grid">
					<div class="product">
						<h4>CentraDesk</h4>
						<div class="cost">$6,985</div>
						<div class="period">Total Cost (3 Years)</div>
						<div class="note">(Includes initial purchase + 2 years of support)</div>
					</div>
					<div class="vs">vs</div>
					<div class="product competitor">
						<h4>Competitors</h4>
						<div class="cost">$10,000+</div>
						<div class="period">Total Cost (3 Years)</div>
						<div class="note">(Based on 4 agents at $55/mo, CAD equivalent)</div>
					</div>
				</div>
			</div>
		</section>

	</main>
	<Footer />
</Layout>

<style>
.pricing-hero { text-align: center; padding: 4rem 0; }
.pricing-hero h1 { font-size: 3rem; font-weight: 800; color: var(--heading-color); }
.subtitle { font-size: 1.25rem; color: var(--subtle-text-color); margin-top: 1rem; max-width: 700px; margin-left: auto; margin-right: auto; }

.pricing-table { padding: 4rem 0; background-color: var(--bg-light-color); }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 900px; margin: auto; }

.card { border: 1px solid var(--border-color); border-radius: 12px; background: white; padding: 2rem; display: flex; flex-direction: column; }
.card.recommended { border: 2px solid var(--primary-color); position: relative; top: -1rem; }

.card-header { position: relative; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
.card-header h3 { margin: 0; font-size: 1.5rem; font-weight: 600; }
.badge { background-color: var(--primary-color); color: white; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 99px; }

.price { font-size: 2.5rem; font-weight: 800; color: var(--heading-color); }
.duration { font-size: 1rem; font-weight: 400; color: var(--subtle-text-color); }
.card-description { color: var(--subtle-text-color); margin-bottom: 2rem; min-height: 40px; }

.features-list { list-style: none; padding: 0; margin: 0 0 2rem 0; flex-grow: 1; }
.features-list li { padding: 0.5rem 0; display: flex; align-items: center; }
.features-list li::before { content: '✓'; color: #2E7D32; font-weight: bold; margin-right: 0.75rem; }

.cta-link { display: block; text-decoration: none; margin-top: auto; }
.cta-button { width: 100%; text-align: center; background-color: var(--primary-color); color: white; padding: 0.75rem 1rem; border-radius: 6px; font-weight: 600; transition: background-color 0.2s; border: 1px solid var(--primary-color); }
.cta-link:hover .cta-button { background-color: var(--primary-hover-color); border-color: var(--primary-hover-color); }

.support-plan { text-align: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border-color); }
.support-plan h3 { border-bottom: none; }
.support-plan p { max-width: 400px; margin: 0.5rem auto 1rem; color: var(--subtle-text-color); }

.value-comparison { padding: 6rem 0; text-align: center; }
.value-comparison h2 { font-size: 2.5rem; font-weight: 800; }
.comparison-grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; max-width: 800px; margin: 3rem auto 0; }
.product { padding: 2rem; border-radius: 12px; border: 1px solid var(--border-color); }
.cost { font-size: 3rem; font-weight: 800; color: var(--heading-color); }
.competitor .cost { color: #B71C1C; }
.period { font-size: 1rem; font-weight: 600; color: var(--subtle-text-color); }
.note { font-size: 0.8rem; color: var(--subtle-text-color); margin-top: 0.5rem; }
.vs { font-size: 1.5rem; font-weight: 600; color: var(--subtle-text-color); }

@media (max-width: 992px) {
    .grid {
        grid-template-columns: 1fr;
    }
    .card.recommended {
        top: 0;
    }
    .comparison-grid {
        grid-template-columns: 1fr;
    }
    .vs {
        display: none;
    }
}
@media (max-width: 768px) {
    .pricing-hero { padding: 3rem 0; }
    .pricing-hero h1 { font-size: 2.25rem; }
    .subtitle { font-size: 1.1rem; }
    .pricing-table { padding: 3rem 0; }
    .value-comparison { padding: 4rem 0; }
}
</style>