---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const pageTitle = "Perpetual License Helpdesk Pricing | CentraDesk";
const pageDescription = "Simple, one-time pricing for a perpetual software license. See the total cost of ownership for our Professional and Business Pro plans. No recurring fees.";
---

<Layout title={pageTitle} description={pageDescription}>
	<Header />
	<main>
		<section class="pricing-hero">
			<div class="container">
				<h1>Simple, Powerful Pricing.</h1>
				<p class="subtitle">A one-time fee for a perpetual license. Stop paying recurring subscriptions and take full ownership of your IT operations, securely inside your own Microsoft 365 environment.</p>
			</div>
		</section>

		<section class="pricing-table">
			<div class="container">
				<div class="grid">
					<div class="card">
						<div class="card-header">
							<h3>Professional</h3>
						</div>
						<div class="price">$7,995 <span class="currency">CAD</span></div>
						<p class="card-description">The complete, professionally installed solution for your organization.</p>
						<ul class="features-list">
							<li><strong>License: Permanent</strong></li>
							<li>Unlimited End-Users & IT Agents</li>
							<li>Full Turnkey Implementation</li>
							<li>All 5 Core Automation Flows Setup</li>
							<li>1-Hour Team Training Session</li>
							<li>1 Year of Standard Support Included</li>
						</ul>
						<a href="mailto:info@centradesk.ca" class="cta-link">
                            <div class="cta-button secondary">Get Started</div>
                        </a>
					</div>
					<div class="card recommended">
						<div class="card-header">
							<h3>Business Pro</h3>
							<span class="badge">Best Value</span>
						</div>
						<div class="price">$11,295 <span class="currency">CAD</span></div>
						<p class="card-description">Everything in Professional, plus advanced analytics and customization.</p>
						<ul class="features-list">
							<li><strong>Everything in Professional, plus:</strong></li>
							<li>Logo & Brand Color Theming</li>
							<li>Power BI Analytics Starter Kit</li>
							<li><strong>Choice of 2 "Integration Accelerators"</strong></li>
							<li>(e.g. Custom Dashboards, Data Migration)</li>
							<li>1 Year of Priority Support Included</li>
						</ul>
						<a href="mailto:info@centradesk.ca" class="cta-link">
                            <div class="cta-button">Get Started</div>
                        </a>
					</div>
				</div>
                
                <div class="support-plan">
                    <h3>Annual Support & Maintenance</h3>
                    <p>Continue to receive product updates, new features, and professional support after your first year.</p>
                    <div class="support-tiers">
                        <div><strong>Standard Plan:</strong> $1,000 CAD / year</div>
                        <div><strong>Priority Plan:</strong> $1,400 CAD / year</div>
                    </div>
                </div>
			</div>
		</section>

		<section class="value-comparison">
			<div class="container">
				<h2>The 5-Year Advantage</h2>
				<p class="subtitle">See the dramatic difference in Total Cost of Ownership (TCO) over five years between a perpetual license and a recurring subscription.</p>
				<div class="comparison-grid">
					<div class="product">
						<h4>CentraDesk Professional</h4>
						<div class="cost">$11,975</div>
						<div class="period">Total Cost (5 Years)</div>
						<div class="note">(Initial purchase + 4 years of standard support)</div>
					</div>
					<div class="vs">vs</div>
					<div class="product competitor">
						<h4>Typical SaaS Competitors</h4>
						<div class="cost">$17,500+</div>
						<div class="period">Total Cost (5 Years)</div>
						<div class="note">(Based on 4 agents at $55/mo, CAD equivalent)</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
.pricing-hero {
    background: linear-gradient(180deg, var(--bg-color) 0%, #f0f4f8 100%);
    text-align: center;
    padding: 5rem 0;
}
.pricing-hero h1 { font-size: 3.25rem; font-weight: 800; color: var(--heading-color); }
.subtitle { font-size: 1.25rem; color: var(--subtle-text-color); margin-top: 1.5rem; max-width: 700px; margin-left: auto; margin-right: auto; }

.pricing-table {
    background: #f0f4f8;
    padding: 5rem 0;
}
.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 900px;
    margin: auto;
    align-items: stretch;
}

.card {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: white;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.3s ease;
}

.card.recommended {
    border: 2px solid var(--primary-color);
    transform: scale(1.05); 
    box-shadow: 0 10px 30px -5px rgba(0, 120, 212, 0.2);
}

.card-header { position: relative; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
.card-header h3 { margin: 0; font-size: 1.5rem; font-weight: 600; color: var(--heading-color); }
.badge { background-color: var(--primary-color); color: white; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 99px; }

.price { font-size: 3rem; font-weight: 800; color: var(--heading-color); line-height: 1; }
.currency { font-size: 1.5rem; font-weight: 600; color: var(--subtle-text-color); margin-left: 0.5rem; }
.card-description { color: var(--subtle-text-color); margin-bottom: 2rem; min-height: 48px; }

.features-list { list-style: none; padding: 0; margin: 0 0 2rem 0; flex-grow: 1; }
.features-list li { padding: 0.6rem 0; display: flex; align-items: center; font-size: 0.95rem; }
.features-list li:first-child { font-size: 1rem; }
.features-list li::before { content: '✓'; color: var(--primary-color); font-weight: bold; margin-right: 0.75rem; font-size: 1.2em; }

.cta-link { display: block; text-decoration: none; margin-top: auto; }
.cta-button { text-align: center; padding: 0.8rem 1rem; border-radius: 6px; font-weight: 600; transition: all 0.2s; border: 2px solid var(--primary-color); }

.card.recommended .cta-button {
    background-color: var(--primary-color); 
    color: white;
}
.card.recommended .cta-link:hover .cta-button {
    background-color: var(--primary-hover-color);
    border-color: var(--primary-hover-color);
}

.card:not(.recommended) .cta-button {
    background-color: transparent;
    color: var(--primary-color);
}
.card:not(.recommended) .cta-link:hover .cta-button {
    background-color: var(--primary-color);
    color: white;
}

.support-plan { text-align: center; margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); }
.support-plan h3 { border-bottom: none; }
.support-plan p { max-width: 500px; margin: 0.5rem auto 1.5rem; color: var(--subtle-text-color); }
.support-tiers { display: flex; justify-content: center; gap: 2rem; font-weight: 600; color: var(--heading-color); }

.value-comparison { padding: 6rem 0; text-align: center; }
.value-comparison h2 { font-size: 2.5rem; font-weight: 800; color: var(--heading-color); }
.comparison-grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; max-width: 800px; margin: 3rem auto 0; }
.product { padding: 2rem; border-radius: 12px; background: white; border: 1px solid var(--border-color); }
.cost { font-size: 3rem; font-weight: 800; color: var(--heading-color); }
.competitor .cost { color: #B71C1C; }
.period { font-size: 1rem; font-weight: 600; color: var(--subtle-text-color); }
.note { font-size: 0.8rem; color: var(--subtle-text-color); margin-top: 0.5rem; }
.vs { font-size: 1.5rem; font-weight: 600; color: var(--subtle-text-color); }

@media (max-width: 992px) {
    .grid {
        grid-template-columns: 1fr;
        max-width: 500px;
    }
    .card.recommended {
        transform: scale(1);
    }
    .comparison-grid {
        grid-template-columns: 1fr;
    }
    .vs {
        display: none;
    }
}
@media (max-width: 992px) {
    .grid {
        grid-template-columns: 1fr;
        max-width: 500px;
    }
    .card.recommended {
        transform: scale(1.02);
        box-shadow: 0 10px 30px -5px rgba(0, 120, 212, 0.2);
    }
    .comparison-grid {
        grid-template-columns: 1fr;
    }
    .vs {
        display: none;
    }
}
</style>